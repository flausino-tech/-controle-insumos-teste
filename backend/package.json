{
  "name": "controle-insumos-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "node src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate --schema=src/db/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=src/db/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema=src/db/schema.prisma",
    "prisma:studio": "prisma studio --schema=src/db/schema.prisma",
    "seed": "node src/db/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^5.20.0",
    "zod": "^3.23.8"
  }
}
